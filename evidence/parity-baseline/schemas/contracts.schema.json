{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "evidenceRef": { "type": "object", "additionalProperties": false, "required": ["path", "sha256", "mediaType"], "properties": { "path": { "type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "mediaType": { "type": "string", "minLength": 1 } } },
    "observation": { "type": "object", "additionalProperties": false, "required": ["identity", "surfaceGroup", "revision", "fixtureId", "fixtureSha256", "environmentId", "procedureId", "normalizationId", "observationSha256"], "properties": { "identity": { "type": "string", "pattern": "^PB-(0[1-9]|1[0-4])$" }, "surfaceGroup": { "type": "string", "minLength": 1 }, "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" }, "fixtureId": { "type": "string", "minLength": 1 }, "fixtureSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "environmentId": { "type": "string", "minLength": 1 }, "procedureId": { "type": "string", "minLength": 1 }, "normalizationId": { "type": "string", "minLength": 1 }, "observationSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
    "parityRow": { "type": "object", "additionalProperties": false, "required": ["identity", "surfaceGroup", "supportedBoundary", "fixture", "observation", "outcome", "forkEvidence", "upstreamEvidence"], "properties": { "identity": { "type": "string", "pattern": "^PB-(0[1-9]|1[0-4])$" }, "surfaceGroup": { "type": "string", "minLength": 1 }, "supportedBoundary": { "type": "string", "minLength": 1 }, "fixture": { "type": "string", "minLength": 1 }, "observation": { "type": "string", "minLength": 1 }, "outcome": { "enum": ["equal", "not-applicable", "platform-variable", "unexplained-difference"] }, "forkEvidence": { "$ref": "#/$defs/evidenceRef" }, "upstreamEvidence": { "$ref": "#/$defs/evidenceRef" }, "explanationEvidence": { "$ref": "#/$defs/evidenceRef" } }, "allOf": [{ "if": { "properties": { "outcome": { "const": "equal" } }, "required": ["outcome"] }, "then": { "not": { "required": ["explanationEvidence"] } }, "else": { "required": ["explanationEvidence"] } }] }
  }
}
