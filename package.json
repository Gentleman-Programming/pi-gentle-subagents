{
  "name": "pi-gentle-subagents",
  "version": "1.0.0",
  "packageManager": "pnpm@11.1.1",
  "description": "Installable Pi package that adds markdown-defined subagents, delegated task tools, history, and model profiles.",
  "type": "module",
  "license": "MIT",
  "author": "j0k3r",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gentleman-Programming/pi-gentle-subagents.git"
  },
  "homepage": "https://github.com/Gentleman-Programming/pi-gentle-subagents#readme",
  "bugs": {
    "url": "https://github.com/Gentleman-Programming/pi-gentle-subagents/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-gentle-subagents",
    "pi",
    "subagents",
    "coding-agent",
    "agent",
    "delegation"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./index.ts",
  "files": [
    "index.ts",
    "src",
    "skills",
    "scripts/verify-package-files.mjs",
    ".releaserc.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:package": "node scripts/verify-package-files.mjs",
    "pack:dry-run": "pnpm pack --dry-run",
    "check": "pnpm run typecheck && pnpm test && pnpm run verify:package",
    "release": "semantic-release",
    "prepublishOnly": "pnpm run check"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@semantic-release/github": "12.0.8",
    "@semantic-release/npm": "13.1.5",
    "@types/node": "24.10.1",
    "semantic-release": "25.0.5",
    "typebox": "1.1.38",
    "typescript": "5.9.3",
    "vitest": "4.1.7"
  }
}
